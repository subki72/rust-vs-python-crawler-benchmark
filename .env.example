# Social Crawler & Ingestion Benchmark Configuration
# Copy to .env for local overrides (never commit .env to version control)

BENCHMARK_TOPICS=rust,python,technology,ai,datascience
BENCHMARK_PAGES=3
BENCHMARK_CONCURRENCY=3
REQUEST_TIMEOUT_SECONDS=15.0
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=0.5

DATA_DIR=data
LOG_LEVEL=INFO

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# Resilience Controls
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_TTL_SECONDS=15.0
